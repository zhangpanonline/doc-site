{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "docusaurus-2",
  "buildCommand": "pnpm build",
  "outputDirectory": "build",
  "installCommand": "pnpm install --ignore-scripts",
  "functions": {
    "api/explain.ts": {
      "regions": ["hkg1"],
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": {
            "re": ".*(headlesschrome|HeadlessChrome|phantomjs|python-requests|python-urllib|scrapy|curl/|Wget/|libwww-perl|okhttp|go-http-client|node-fetch|axios/|aiohttp|httpx|Java/).*"
          }
        }
      ],
      "mitigate": { "action": "challenge" }
    },
    {
      "src": "/(.*)",
      "missing": [
        { "type": "header", "key": "user-agent" }
      ],
      "mitigate": { "action": "challenge" }
    }
  ],
  "redirects": [
    {
      "source": "/python/%e5%ae%89%e8%a3%85/:path*",
      "destination": "/agents/python/python%e7%8e%af%e5%a2%83%e5%ae%89%e8%a3%85/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/%e5%9f%ba%e7%a1%80%e8%af%ad%e6%b3%95/:path*",
      "destination": "/agents/python/python%e5%9f%ba%e6%9c%ac%e8%af%ad%e6%b3%95/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/Lambda%e8%a1%a8%e8%be%be%e5%bc%8f/:path*",
      "destination": "/agents/python/lambda%e8%a1%a8%e8%be%be%e5%bc%8f/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/%e6%8a%bd%e8%b1%a1%e7%b1%bb/:path*",
      "destination": "/agents/python/ABC/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/%e5%8d%8f%e7%a8%8b/:path*",
      "destination": "/agents/python/%e5%8d%8f%e7%a8%8b-Coroutine/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/%e5%a4%9a%e7%ba%bf%e7%a8%8b%e5%92%8c%e5%a4%9a%e8%bf%9b%e7%a8%8b/:path*",
      "destination": "/agents/python/%e5%a4%9a%e7%ba%bf%e7%a8%8b%e4%b8%8e%e5%a4%9a%e8%bf%9b%e7%a8%8b/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/Monorepo/:path*",
      "destination": "/agents/python/monorepo/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/%e8%af%ad%e8%a8%80%e6%a0%b8%e5%bf%83/:path*",
      "destination": "/agents/python/:path*",
      "statusCode": 301
    },
    {
      "source": "/python/:path*",
      "destination": "/agents/python/:path*",
      "statusCode": 301
    }
  ]
}